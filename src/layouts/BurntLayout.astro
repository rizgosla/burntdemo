---
import "../styles/burnt.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = "Burnt Crumbs | Best Brunch & Breakfast in Irvine, CA",
  description = "Scratch-made brunch and breakfast in Irvine, CA. Home of the spaghetti grilled cheese, soufflé pancakes, Nashville hot chicken, and sauce by the ounce. Est. 2010.",
  canonical = "https://burntcrumbs.com/",
  ogImage = "https://burntcrumbs.com/media/burnt-title.jpg",
} = Astro.props;

const restaurantSchema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "name": "Burnt Crumbs",
  "url": "https://burntcrumbs.com",
  "telephone": "+19495025998",
  "priceRange": "$$",
  "servesCuisine": ["American", "Brunch", "Breakfast", "Sandwiches"],
  "description": "Scratch-made brunch and breakfast restaurant in Irvine, CA. Est. 2010. Chef-run, family-owned.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "8549 Irvine Center Dr",
    "addressLocality": "Irvine",
    "addressRegion": "CA",
    "postalCode": "92618",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 33.6454,
    "longitude": -117.7688
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "08:30",
      "closes": "15:00"
    }
  ],
  "hasMenu": "https://burntcrumbs.com/menu",
  "menu": "https://burntcrumbs.com/menu",
  "sameAs": [
    "https://www.instagram.com/burntcrumbs",
    "https://www.facebook.com/burntcrumbs/",
    "https://www.yelp.com/biz/burnt-crumbs-irvine"
  ],
  "image": "https://burntcrumbs.com/media/burnt-title.jpg"
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e0a07" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="restaurant" />
    <meta property="og:site_name" content="Burnt Crumbs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Restaurant Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(restaurantSchema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-paper text-char font-body">
    <slot />

    <script is:inline>
      (() => {
        const $ = (s, r = document) => r.querySelector(s);
        const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
        const MEDIA = "/media";

        // ── Stop-motion: build frames, then auto-loop at 500ms ──────────────
        const SLIDES = {
          burrito: [1, 2, 3, 4, 5, 6, 7, 8, 9].map((n) => `burrito-${n}.png`),
          chicken: range(39, 48),
          pancake: range(96, 108),
          salad: [185, 186, 187, 189, 190, 191, 192, 193, 194],
        };
        function range(a, b) {
          const out = [];
          for (let i = a; i <= b; i++) out.push(i);
          return out;
        }
        function fname(n) {
          if (typeof n === "string") return n;
          return `GoodTimesMedia_BurntCrumbsAugust2024${String(n).padStart(3, "0")}.jpg`;
        }

        $$(".burnt-stage").forEach((stage) => {
          const key = stage.dataset.folder;
          const wrap = $(".burnt-frames", stage);
          const arr = SLIDES[key] || [];
          arr.forEach((n, i) => {
            const img = document.createElement("img");
            img.src = `${MEDIA}/slideshow-${key}/${fname(n)}`;
            img.alt = "";
            img.loading = i < 2 ? "eager" : "lazy";
            img.decoding = "async";
            if (i === 0) img.classList.add("on");
            wrap.appendChild(img);
          });
        });

        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        if (!reduceMotion) {
          $$(".burnt-stage").forEach((stage) => {
            const imgs = $$(".burnt-frames img", stage);
            if (!imgs.length) return;
            let idx = 0;
            setInterval(() => {
              imgs[idx].classList.remove("on");
              idx = (idx + 1) % imgs.length;
              imgs[idx].classList.add("on");
            }, 500);
          });
        }

        // ── Curved carousel (native scroll, finite 8 cards) ─────────────────
        // Native horizontal scroll handles momentum (often off the main
        // thread), so a fast fling can never lock up. No loop / clones / JS
        // repositioning — that machinery is what used to jump or freeze.
        const carousel = $("#carousel");
        if (carousel) {
          const cards = $$(".burnt-card", carousel);
          const dots = $("#carousel-dots");
          const numEl = $("#ci-num");
          const nameEl = $("#ci-name");
          const priceEl = $("#ci-price");

          // Card centre within the scroll content. offsetLeft is a layout value
          // that CSS transforms don't affect, so reading it never forces a
          // reflow even though we write transforms each frame — that's what
          // keeps fast scrolling smooth.
          const centerOf = (card) => card.offsetLeft + card.offsetWidth / 2;

          let activeIdx = -1;
          const setActive = (i) => {
            if (i === activeIdx) return;
            activeIdx = i;
            const card = cards[i];
            numEl.textContent = String(i + 1).padStart(2, "0");
            if (card) {
              nameEl.textContent = card.dataset.name || "";
              priceEl.textContent = card.dataset.price || "";
            }
            $$(".burnt-dot", dots).forEach((b, di) => {
              b.style.background =
                di === i ? "var(--color-ember)" : "rgba(245,237,224,0.25)";
              b.style.width = di === i ? "18px" : "6px";
            });
          };

          // Auto-advance; any direct input pauses it, resuming after idle. At
          // the end it eases back to the first card.
          let step = 0;
          let autoTimer = null;
          let resumeTimer = null;
          const stopAuto = () => {
            clearInterval(autoTimer);
            autoTimer = null;
          };
          const startAuto = () => {
            if (reduceMotion || autoTimer || !step) return;
            autoTimer = setInterval(() => {
              const atEnd =
                carousel.scrollLeft + carousel.clientWidth >=
                carousel.scrollWidth - 4;
              if (atEnd) carousel.scrollTo({ left: 0, behavior: "smooth" });
              else carousel.scrollBy({ left: step, behavior: "smooth" });
            }, 3500);
          };
          const pauseThenResume = () => {
            stopAuto();
            clearTimeout(resumeTimer);
            resumeTimer = setTimeout(startAuto, 5000);
          };

          // One dot per dish; click centres that card.
          cards.forEach((card, i) => {
            const b = document.createElement("button");
            b.className = "burnt-dot";
            b.setAttribute("aria-label", `Go to dish ${i + 1}`);
            b.style.cssText =
              "width:6px;height:6px;border-radius:99px;background:rgba(245,237,224,0.25);border:0;padding:0;transition:width 200ms,background 200ms;";
            b.addEventListener("click", () => {
              pauseThenResume();
              carousel.scrollTo({
                left: centerOf(card) - carousel.clientWidth / 2,
                behavior: "smooth",
              });
            });
            dots.appendChild(b);
          });

          // Curved look + live readout. Reads only scrollLeft / offsetLeft and
          // writes only transforms, so there's no layout thrashing.
          const update = () => {
            const cw = carousel.clientWidth;
            const center = carousel.scrollLeft + cw / 2;
            const reach = cw * 0.6;
            let closest = 0;
            let closestDist = Infinity;
            for (let i = 0; i < cards.length; i++) {
              const dx = centerOf(cards[i]) - center;
              const clamped = Math.max(-1.4, Math.min(1.4, dx / reach));
              const abs = Math.abs(clamped);
              const y = abs * abs * 50;
              const rot = clamped * 10;
              const scale = 1 - Math.min(0.18, abs * 0.16);
              cards[i].style.transform = `translateY(${y}px) rotate(${rot}deg) scale(${scale})`;
              cards[i].style.opacity = String(1 - Math.min(0.45, abs * 0.4));
              cards[i].style.zIndex = String(100 - Math.round(abs * 100));
              const adx = Math.abs(dx);
              if (adx < closestDist) {
                closestDist = adx;
                closest = i;
              }
            }
            setActive(closest);
          };

          // Throttle to one update per animation frame, no matter how many
          // scroll events fire.
          let ticking = false;
          carousel.addEventListener(
            "scroll",
            () => {
              if (ticking) return;
              ticking = true;
              requestAnimationFrame(() => {
                update();
                ticking = false;
              });
            },
            { passive: true }
          );
          ["pointerdown", "touchstart", "wheel", "keydown"].forEach((ev) =>
            carousel.addEventListener(ev, pauseThenResume, { passive: true })
          );
          carousel.addEventListener("mouseenter", stopAuto);
          carousel.addEventListener("mouseleave", startAuto);

          requestAnimationFrame(() => {
            step =
              cards.length > 1 ? centerOf(cards[1]) - centerOf(cards[0]) : 0;
            update();
            startAuto();
          });
        }

        // ── Mobile menu toggle ──────────────────────────────────────────────
        const menuBtn = $("#burnt-menu-btn");
        const mobileMenu = $("#burnt-mobile-menu");
        menuBtn?.addEventListener("click", () => {
          const open = mobileMenu.classList.toggle("hidden");
          menuBtn.setAttribute("aria-expanded", String(!open));
        });
        $$("#burnt-mobile-menu a").forEach((a) =>
          a.addEventListener("click", () => mobileMenu.classList.add("hidden"))
        );

        // ── Nav state + sticky CTA ──────────────────────────────────────────
        const nav = $("#burnt-nav");
        const sticky = $("#burnt-sticky");
        const hero = $("#burnt-hero");

        // Mon–Sun 8:30 AM – 3:00 PM Pacific Time
        const isOpenNow = () => {
          const pt = new Date(new Date().toLocaleString("en-US", { timeZone: "America/Los_Angeles" }));
          const mins = pt.getHours() * 60 + pt.getMinutes();
          return mins >= 510 && mins < 900; // 510 = 8:30, 900 = 15:00
        };

        const onScroll = () => {
          const y = window.scrollY || document.documentElement.scrollTop;
          nav?.classList.toggle("shadow-lg", y > 80);
          if (hero && sticky) {
            const heroBottom = hero.offsetTop + hero.offsetHeight;
            const on = y > heroBottom - 200 && isOpenNow();
            sticky.classList.toggle("opacity-0", !on);
            sticky.classList.toggle("translate-y-6", !on);
            sticky.classList.toggle("pointer-events-none", !on);
          }
        };
        document.addEventListener(
          "scroll",
          () => requestAnimationFrame(onScroll),
          { passive: true }
        );
        requestAnimationFrame(onScroll);
      })();
    </script>
  </body>
</html>
