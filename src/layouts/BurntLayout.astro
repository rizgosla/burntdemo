---
import "../styles/burnt.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = "Burnt Crumbs | Best Brunch & Breakfast in Irvine, CA",
  description = "Scratch-made brunch and breakfast in Irvine, CA. Home of the spaghetti grilled cheese, soufflé pancakes, Nashville hot chicken, and sauce by the ounce. Est. 2010.",
  canonical = "https://burntcrumbs.com/",
  ogImage = "https://burntcrumbs.com/media/burnt-title.jpg",
} = Astro.props;

const restaurantSchema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "name": "Burnt Crumbs",
  "url": "https://burntcrumbs.com",
  "telephone": "+19495025998",
  "priceRange": "$$",
  "servesCuisine": ["American", "Brunch", "Breakfast", "Sandwiches"],
  "description": "Scratch-made brunch and breakfast restaurant in Irvine, CA. Est. 2010. Chef-run, family-owned.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "8549 Irvine Center Dr",
    "addressLocality": "Irvine",
    "addressRegion": "CA",
    "postalCode": "92618",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 33.6454,
    "longitude": -117.7688
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "08:30",
      "closes": "15:00"
    }
  ],
  "hasMenu": "https://burntcrumbs.com/menu",
  "menu": "https://burntcrumbs.com/menu",
  "sameAs": [
    "https://www.instagram.com/burntcrumbs",
    "https://www.facebook.com/burntcrumbs/",
    "https://www.yelp.com/biz/burnt-crumbs-irvine"
  ],
  "image": "https://burntcrumbs.com/media/burnt-title.jpg"
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e0a07" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="restaurant" />
    <meta property="og:site_name" content="Burnt Crumbs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Restaurant Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(restaurantSchema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-paper text-char font-body">
    <slot />

    <script is:inline>
      (() => {
        const $ = (s, r = document) => r.querySelector(s);
        const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
        const MEDIA = "/media";

        // ── Stop-motion: build frames, then auto-loop at 500ms ──────────────
        const SLIDES = {
          burrito: range(72, 80),
          chicken: range(39, 48),
          pancake: range(96, 108),
          salad: [185, 186, 187, 189, 190, 191, 192, 193, 194],
        };
        function range(a, b) {
          const out = [];
          for (let i = a; i <= b; i++) out.push(i);
          return out;
        }
        function fname(n) {
          return `GoodTimesMedia_BurntCrumbsAugust2024${String(n).padStart(3, "0")}.jpg`;
        }

        $$(".burnt-stage").forEach((stage) => {
          const key = stage.dataset.folder;
          const wrap = $(".burnt-frames", stage);
          const arr = SLIDES[key] || [];
          arr.forEach((n, i) => {
            const img = document.createElement("img");
            img.src = `${MEDIA}/slideshow-${key}/${fname(n)}`;
            img.alt = "";
            img.loading = i < 2 ? "eager" : "lazy";
            img.decoding = "async";
            if (i === 0) img.classList.add("on");
            wrap.appendChild(img);
          });
        });

        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        if (!reduceMotion) {
          $$(".burnt-stage").forEach((stage) => {
            const imgs = $$(".burnt-frames img", stage);
            if (!imgs.length) return;
            let idx = 0;
            setInterval(() => {
              imgs[idx].classList.remove("on");
              idx = (idx + 1) % imgs.length;
              imgs[idx].classList.add("on");
            }, 500);
          });
        }

        // ── Curved carousel ─────────────────────────────────────────────────
        // Powered by Embla (see the bundled <script> below). Embla owns the
        // infinite loop + momentum via transforms — no native scroll-snap to
        // fight when flinging fast — and we layer the curved 3D look on top.

        // ── Mobile menu toggle ──────────────────────────────────────────────
        const menuBtn = $("#burnt-menu-btn");
        const mobileMenu = $("#burnt-mobile-menu");
        menuBtn?.addEventListener("click", () => {
          const open = mobileMenu.classList.toggle("hidden");
          menuBtn.setAttribute("aria-expanded", String(!open));
        });
        $$("#burnt-mobile-menu a").forEach((a) =>
          a.addEventListener("click", () => mobileMenu.classList.add("hidden"))
        );

        // ── Nav state + sticky CTA ──────────────────────────────────────────
        const nav = $("#burnt-nav");
        const sticky = $("#burnt-sticky");
        const hero = $("#burnt-hero");

        // Mon–Sun 8:30 AM – 3:00 PM Pacific Time
        const isOpenNow = () => {
          const pt = new Date(new Date().toLocaleString("en-US", { timeZone: "America/Los_Angeles" }));
          const mins = pt.getHours() * 60 + pt.getMinutes();
          return mins >= 510 && mins < 900; // 510 = 8:30, 900 = 15:00
        };

        const onScroll = () => {
          const y = window.scrollY || document.documentElement.scrollTop;
          nav?.classList.toggle("shadow-lg", y > 80);
          if (hero && sticky) {
            const heroBottom = hero.offsetTop + hero.offsetHeight;
            const on = y > heroBottom - 200 && isOpenNow();
            sticky.classList.toggle("opacity-0", !on);
            sticky.classList.toggle("translate-y-6", !on);
            sticky.classList.toggle("pointer-events-none", !on);
          }
        };
        document.addEventListener(
          "scroll",
          () => requestAnimationFrame(onScroll),
          { passive: true }
        );
        requestAnimationFrame(onScroll);
      })();
    </script>

    <!-- Curved "classics you came for" carousel, powered by Embla. This is a
         bundled module script (not is:inline) so the npm imports are processed
         by Astro/Vite. -->
    <script>
      import EmblaCarousel from "embla-carousel";
      import { WheelGesturesPlugin } from "embla-carousel-wheel-gestures";

      const viewport = document.querySelector("#carousel");
      if (viewport) {
        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        const numEl = document.querySelector("#ci-num");
        const nameEl = document.querySelector("#ci-name");
        const priceEl = document.querySelector("#ci-price");
        const dotsWrap = document.querySelector("#carousel-dots");

        // Embla drives the infinite loop and momentum with transforms, so a
        // fast fling never fights native scroll-snap (the old "jump"). The
        // wheel-gestures plugin keeps trackpad / mouse-wheel scrolling working.
        const embla = EmblaCarousel(
          viewport,
          { loop: true, align: "center", dragFree: false, containScroll: false },
          [WheelGesturesPlugin()]
        );

        const slides = embla.slideNodes();

        // Auto-advance; any direct interaction pauses it, and it resumes after
        // a few idle seconds. Declared early so the dot handlers can call it.
        let autoTimer = null;
        let resumeTimer = null;
        const stopAuto = () => {
          clearInterval(autoTimer);
          autoTimer = null;
        };
        const startAuto = () => {
          if (reduceMotion || autoTimer) return;
          autoTimer = setInterval(() => embla.scrollNext(), 3500);
        };
        const pauseThenResume = () => {
          stopAuto();
          clearTimeout(resumeTimer);
          resumeTimer = setTimeout(startAuto, 5000);
        };

        // Navigation dots.
        const dotButtons = slides.map((_, i) => {
          const b = document.createElement("button");
          b.className = "burnt-dot";
          b.setAttribute("aria-label", `Go to dish ${i + 1}`);
          b.style.cssText =
            "width:6px;height:6px;border-radius:99px;background:rgba(245,237,224,0.25);border:0;padding:0;transition:width 200ms,background 200ms;";
          b.addEventListener("click", () => {
            pauseThenResume();
            embla.scrollTo(i);
          });
          dotsWrap.appendChild(b);
          return b;
        });

        // Curved 3D look: transform each card's inner wrapper by how far its
        // centre sits from the viewport centre. We measure the slide (which
        // carries Embla's own loop/scroll transform) and write to the inner
        // element + the slide's z-index, so we never clobber Embla's layout.
        const tween = () => {
          const vp = viewport.getBoundingClientRect();
          const cx = vp.left + vp.width / 2;
          const reach = vp.width * 0.6;
          slides.forEach((slide) => {
            const inner = slide.firstElementChild;
            if (!inner) return;
            const r = slide.getBoundingClientRect();
            const dx = r.left + r.width / 2 - cx;
            const clamped = Math.max(-1.4, Math.min(1.4, dx / reach));
            const abs = Math.abs(clamped);
            const y = abs * abs * 50;
            const rot = clamped * 10;
            const scale = 1 - Math.min(0.18, abs * 0.16);
            inner.style.transform = `translateY(${y}px) rotate(${rot}deg) scale(${scale})`;
            inner.style.opacity = String(1 - Math.min(0.45, abs * 0.4));
            slide.style.zIndex = String(100 - Math.round(abs * 100));
          });
        };

        const syncSelected = () => {
          const i = embla.selectedScrollSnap();
          const slide = slides[i];
          if (slide) {
            numEl.textContent = String(i + 1).padStart(2, "0");
            nameEl.textContent = slide.dataset.name || "";
            priceEl.textContent = slide.dataset.price || "";
          }
          dotButtons.forEach((b, di) => {
            b.style.background =
              di === i ? "var(--color-ember)" : "rgba(245,237,224,0.25)";
            b.style.width = di === i ? "18px" : "6px";
          });
        };

        embla
          .on("scroll", tween)
          .on("slideFocus", tween)
          .on("select", syncSelected)
          .on("reInit", () => {
            tween();
            syncSelected();
          });
        tween();
        syncSelected();

        embla.on("pointerDown", pauseThenResume);
        viewport.addEventListener("wheel", pauseThenResume, { passive: true });
        viewport.addEventListener("mouseenter", stopAuto);
        viewport.addEventListener("mouseleave", startAuto);
        if (!reduceMotion) startAuto();
      }
    </script>
  </body>
</html>
