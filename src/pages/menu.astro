    eyebrow: "Scene 04",
    items: [
      "Spaghetti Grilled Cheese",
      "Fried Chicken Sandwich",
      "Nashville Hot Chicken",
      "Classic Club Sandwich",
      "Shredded Beef Sandwich",
    ],
  },
  {
    name: "Sides",
    eyebrow: "Scene 05",
    items: [
      "Bacon (3)",
      "Breakfast Sausage",
      "Biscuit + Gravy",
      "Biscuit",
      "Home Fried Potatoes",
      "Hand Cut Fries",
      "Fresh Cut Chips",
      "Carne Asada Fries",
      "Kids Grilled Cheese",
    ],
  },
  {
