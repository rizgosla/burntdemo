---
import BurntLayout from "../layouts/BurntLayout.astro";

const M = "/media";

const arrow = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10m0 0L8 3m4 4l-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const navLinks = [
  { label: "Menu", href: "/menu" },
  { label: "Story", href: "/#" },
  { label: "Catering", href: "/#" },
  { label: "Find Us", href: "/#" },
];

const slug = (s) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const STORE = "https://direct.chownow.com/order/7543/locations/10100";
const order = (id) => `${STORE}?menu_item_id=${id}`;

// Per-item ChowNow deep links, keyed by the exact item name below.
// Items without an entry fall back to the main store page.
const SOUFFLE = order("2609972_3132168"); // all pancake options select kind on site
const links = {
  // Breakfast Entrées
  "Two Egg Plate": order("2609933_3132128"),
  "Breakfast Quesadillas": order("M_335010_5197126"),
  "Breakfast Burrito": order("M_335010_2609754"),
  "Carne Asada Omelette": order("2609926_3132121"),
  "Avocado Toast": order("M_335010_2609924"),
  "Shredded Beef Chilaquiles": order("7552607_8740377"),
  "Breakfast Salad": order("2609723_3131879"),
  "Carne Asada Salad": order("1887604_2260521"),
  // Pancakes
  "Original": SOUFFLE,
  "Strawberry Cream and Fresh Strawberry": SOUFFLE,
  "Berry Compote and Vanilla Cream": SOUFFLE,
  "Weekly Special: Mango Cream": SOUFFLE,
  // Breakfast Sandwiches
  "Soft Scrambled Egg + Cheddar": order("2609944_3132139"),
  "Bacon + Egg + Cheddar": order("2609731_3131887"),
  "Sausage + Egg + Cheddar": order("2609946_3132141"),
  "Pastrami Hash + Egg + Cheddar": order("2609950_3132145"),
  "Country Fried Steak + Egg + Cheddar": order("3842664_4593215"),
  // Lunch Sandwiches
  "Spaghetti Grilled Cheese": order("920786_1100898"),
  "Fried Chicken Sandwich": order("920785_1100897"),
  "Nashville Hot Chicken": order("3320187_3969693"),
  "Classic Club Sandwich": order("2312397_2773074"),
  "Shredded Beef Sandwich": order("7505949_8691967"),
  // Sides
  "Bacon (3)": order("2609934_3132132"),
  "Breakfast Sausage": order("2609728_3131884"),
  "Biscuit + Gravy": order("3038773_3638772"),
  "Biscuit": order("2609938_3132133"),
  "Home Fried Potatoes": order("2609937_3132130"),
  "Hand Cut Fries": order("1748263_2094329"),
  "Fresh Cut Chips": order("920796_1100908"),
  "Carne Asada Fries": order("1630789_1951727"),
  "Kids Grilled Cheese": order("920801_1100913"),
  // Drinks
  "Soda": order("1887693_2260614"),
  "Sweet Tea": order("922250_5527496"),
  "Vietnamese Iced Coffee": order("2609761_5527495"),
  "Orange Juice": order("2609939_3132134"),
};

const categories = [
  {
    name: "Breakfast Entrées",
    eyebrow: "Scene 01",
    items: [
      "Two Egg Plate",
      "Breakfast Quesadillas",
      "Breakfast Burrito",
      "Carne Asada Omelette",
      "Avocado Toast",
      "Breakfast Fried Rice",
      "Shredded Beef Chilaquiles",
      "Breakfast Salad",
      "Carne Asada Salad",
    ],
  },
  {
    name: "Pancakes",
    eyebrow: "Scene 02",
    items: [
      "Original",
      "Strawberry Cream and Fresh Strawberry",
      "Berry Compote and Vanilla Cream",
      "Weekly Special: Mango Cream",
    ],
  },
  {
    name: "Breakfast Sandwiches",
    eyebrow: "Scene 03",
    items: [
      "Soft Scrambled Egg + Cheddar",
      "Bacon + Egg + Cheddar",
      "Sausage + Egg + Cheddar",
      "Pastrami Hash + Egg + Cheddar",
      "Country Fried Steak + Egg + Cheddar",
    ],
  },
  {
    name: "Lunch Sandwiches",
    eyebrow: "Scene 04",
    items: [
      "Spaghetti Grilled Cheese",
      "Fried Chicken Sandwich",
      "Nashville Hot Chicken",
      "Classic Club Sandwich",
      "Shredded Beef Sandwich",
    ],
  },
  {
    name: "Sides",
    eyebrow: "Scene 05",
    items: [
      "Bacon (3)",
      "Breakfast Sausage",
      "Biscuit + Gravy",
      "Biscuit",
      "Home Fried Potatoes",
      "Hand Cut Fries",
      "Fresh Cut Chips",
      "Carne Asada Fries",
      "Kids Grilled Cheese",
    ],
  },
  {
    name: "Drinks",
    eyebrow: "Scene 06",
    items: [
      "Soda",
      "Sweet Tea",
      "Lemonade w/ Fruit Puree",
      "Vietnamese Iced Coffee",
      "Orange Juice",
      "Hot Coffee",
      "Mimosa",
    ],
  },
].map((c) => ({ ...c, slug: slug(c.name) }));
---

<BurntLayout title="Burnt Crumbs · Menu" description="The full Burnt Crumbs menu — breakfast entrées, soufflé pancakes, breakfast & lunch sandwiches, sides, and drinks. Scratch-made daily in Irvine, CA.">
  <!-- ── Nav ───────────────────────────────────────────────────────── -->
  <header
    id="burnt-nav"
    class="sticky top-0 z-[70] bg-ink text-paper transition-shadow"
  >
    <div class="mx-auto flex max-w-screen-xl items-center justify-between px-4 py-3 md:px-8 md:py-4">
      <a href="/"><img src={`${M}/logo.png`} alt="Burnt Crumbs" class="h-9 w-auto drop-shadow md:h-11" /></a>

      <nav class="hidden items-center gap-8 md:flex">
        {navLinks.map((l) => (
          <a href={l.href} class="font-display text-[13px] font-medium uppercase tracking-[0.14em] text-paperdim transition-colors hover:text-paper">{l.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a
          href="#"
          class="inline-flex items-center gap-1.5 rounded-full bg-ember px-4 py-2.5 font-display text-[13px] font-semibold uppercase tracking-[0.1em] text-paper shadow-[0_4px_16px_rgba(197,69,58,0.45),inset_0_1px_0_rgba(255,255,255,0.18)]"
          >Order</a
        >
        <button
          id="burnt-menu-btn"
          aria-label="Menu"
          aria-expanded="false"
          class="grid h-[42px] w-[42px] place-items-center rounded-full border border-paper/20 bg-paper/[0.18] backdrop-blur md:hidden"
        >
          <div>
            <span class="my-[3px] block h-[1.6px] w-[18px] rounded bg-paper"></span>
            <span class="my-[3px] block h-[1.6px] w-[18px] rounded bg-paper"></span>
            <span class="my-[3px] block h-[1.6px] w-[18px] rounded bg-paper"></span>
          </div>
        </button>
      </div>
    </div>

    <!-- mobile dropdown -->
    <div id="burnt-mobile-menu" class="hidden border-t border-paper/10 bg-ink px-4 pb-4 md:hidden">
      <nav class="flex flex-col">
        {navLinks.map((l) => (
          <a href={l.href} class="border-b border-paper/10 py-3 font-display text-sm font-medium uppercase tracking-[0.14em] text-paperdim last:border-0">{l.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <!-- ── Menu Header ───────────────────────────────────────────────── -->
  <section class="bg-char px-5 pb-10 pt-14 text-paper md:px-8 md:pb-12 md:pt-20 lg:px-12">
    <div class="mx-auto max-w-screen-xl">
      <div class="font-display text-[11px] font-medium uppercase tracking-[0.2em] text-paper/55">
        <span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-ember align-middle"></span>The full menu
      </div>
      <h1 class="my-3 font-display text-[64px] font-bold uppercase leading-[0.9] tracking-[-0.01em] md:text-[88px]">
        Everything,<br /><em class="font-serif italic font-bold text-ember">scratch made.</em>
      </h1>
      <p class="mt-2.5 max-w-[40ch] font-serif text-[17px] italic leading-[1.4] text-paperdim">
        Pick a lane. Every plate is made to order, every sauce is made in-house.
      </p>
    </div>
  </section>

  <!-- ── Category Tabs (sticky) ────────────────────────────────────── -->
  <div
    id="menu-tabs"
    class="sticky top-[60px] z-[60] border-y border-paper/10 bg-ink/95 backdrop-blur md:top-[72px]"
  >
    <div class="burnt-no-scrollbar mx-auto flex max-w-screen-xl gap-2 overflow-x-auto px-4 py-3 md:px-8 lg:px-12">
      {categories.map((c, i) => (
        <button
          type="button"
          class="menu-tab shrink-0 whitespace-nowrap rounded-full border border-paper/20 px-4 py-2 font-display text-[12px] font-semibold uppercase tracking-[0.12em] text-paperdim transition-colors"
          data-target={`cat-${c.slug}`}
          aria-selected={i === 0 ? "true" : "false"}
        >{c.name}</button>
      ))}
    </div>
  </div>

  <!-- ── Category Sections ─────────────────────────────────────────── -->
  <main class="bg-paper">
    {categories.map((c, i) => (
      <section
        id={`cat-${c.slug}`}
        class="menu-section px-5 py-12 md:px-8 md:py-16 lg:px-12"
        data-target={`cat-${c.slug}`}
        hidden={i !== 0}
      >
        <div class="mx-auto max-w-screen-xl">
          <div class="font-display text-[11px] font-medium uppercase tracking-[0.2em] text-char/55">
            <span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-ember align-middle"></span>{c.eyebrow}
          </div>
          <h2 class="mb-7 mt-3 font-display text-[44px] font-bold uppercase leading-[0.94] tracking-[-0.01em] text-char md:text-[56px]">
            {c.name}
          </h2>
          <div class="grid grid-cols-2 gap-3.5 sm:grid-cols-3 lg:grid-cols-4">
            {c.items.map((name) => (
              <a
                href={links[name] ?? STORE}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Order ${name}`}
                class="group relative isolate flex aspect-[4/5] items-end overflow-hidden rounded-[18px] bg-[#2a1d15] p-3.5 text-paper shadow-[0_18px_40px_rgba(0,0,0,0.18)] transition-transform hover:-translate-y-0.5"
              >
                <img
                  src={`${M}/${slug(name)}.jpg`}
                  alt={name}
                  loading="lazy"
                  class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
                <span class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(0,0,0,0.05),rgba(0,0,0,0.5)_60%,rgba(0,0,0,0.82)_100%)]"></span>
                <div class="font-display text-[19px] font-bold uppercase leading-[1.02] tracking-[0.01em] md:text-[22px]">{name}</div>
                <span class="absolute right-3 top-3 grid h-8 w-8 place-items-center rounded-full bg-paper text-char opacity-90"><Fragment set:html={arrow} /></span>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}
  </main>

  <!-- ── Footer ────────────────────────────────────────────────────── -->
  <footer class="bg-char px-5 pb-28 pt-12 text-paperdim md:px-8 md:pb-12 md:pt-20 lg:px-12">
    <div class="mx-auto max-w-screen-xl md:grid md:grid-cols-2 md:gap-12">
      <div>
        <div class="font-display text-[78px] font-bold uppercase leading-[0.88] tracking-[-0.01em] text-paper md:text-[96px]">
          Keeping it<br /><em class="font-serif italic font-bold text-ember">#ScratchMade</em>
        </div>
        <p class="mt-[18px] max-w-[30ch] font-serif text-[15px] italic leading-[1.4] text-paper/55">Scratch-made since 2010. Started as The Burnt Truck. Still chef-run, still family.</p>
      </div>
      <div class="mt-8 md:mt-0">
        <div class="grid grid-cols-2 gap-[18px_14px]">
          {["Order Online", "Catering", "Full Menu", "Merch", "Our Story", "Contact"].map((l) => (
            <a href={l === "Full Menu" ? "/menu" : "/"} class="font-display text-[13px] font-medium uppercase tracking-[0.06em] text-paper">{l} <span class="ml-1 text-ember">↗</span></a>
          ))}
        </div>
      </div>
    </div>
    <div class="mx-auto mt-[18px] flex max-w-screen-xl justify-between border-t border-paper/10 pt-[18px] font-body text-[11px] text-paper/40">
      <span>© 2026 Burnt Crumbs</span>
      <span class="flex gap-2.5"><a href="#">Privacy</a><a href="#">Terms</a></span>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const tabs = Array.from(document.querySelectorAll(".menu-tab"));
      const sections = Array.from(document.querySelectorAll(".menu-section"));
      if (!tabs.length) return;

      const ACTIVE =
        "bg-ember text-paper border-ember shadow-[0_4px_16px_rgba(197,69,58,0.4)]";

      const setActive = (target, scroll) => {
        tabs.forEach((t) => {
          const on = t.dataset.target === target;
          t.setAttribute("aria-selected", String(on));
          ACTIVE.split(" ").forEach((cls) => t.classList.toggle(cls, on));
        });
        sections.forEach((s) => {
          s.hidden = s.dataset.target !== target;
        });
        if (scroll) {
          const tabsBar = document.getElementById("menu-tabs");
          const offset = (tabsBar?.offsetHeight || 0) + 70;
          const top =
            window.scrollY +
            (tabsBar?.getBoundingClientRect().bottom || 0);
          window.scrollTo({ top: top - offset + 1, behavior: "smooth" });
        }
      };

      tabs.forEach((t) =>
        t.addEventListener("click", () => {
          setActive(t.dataset.target, false);
          history.replaceState(null, "", `#${t.dataset.target}`);
        })
      );

      const hash = decodeURIComponent(location.hash.replace("#", ""));
      const initial =
        tabs.find((t) => t.dataset.target === hash)?.dataset.target ||
        tabs[0].dataset.target;
      setActive(initial, false);
    })();
  </script>
</BurntLayout>
