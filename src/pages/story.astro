---
import BurntLayout from "../layouts/BurntLayout.astro";

const M = "/media";
const ORDER_NOW = "https://direct.chownow.com/order/7543/locations/10100?source=pop_up&spot_id=73610&destination=order&promotion=order_online";

const arrow = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10m0 0L8 3m4 4l-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const navLinks = [
  { label: "Menu", href: "/menu" },
  { label: "Story", href: "/story" },
  { label: "Catering", href: "https://tmt.spotapps.co/catering?spot_id=73610&callback_url=http://burntcrumbs.com/#", external: true },
  { label: "Merch", href: "https://burntcrumbs.bigcartel.com/", external: true },
  { label: "Careers", href: "https://tmt.spotapps.co/job-listings?spot_id=73610&callback_url=http%3A%2F%2Fburntcrumbs.com%2F", external: true },
  { label: "Find Us", href: "/#find-us" },
];

const socialLinks = [
  {
    label: "Yelp",
    href: "https://www.yelp.com/biz/burnt-crumbs-irvine",
    vb: "0 0 24 24",
    icon: `<path d="M21.111 18.226c-.141.969-2.119 3.483-3.029 3.847-.311.124-.611.094-.85-.09-.154-.12-.314-.365-2.447-3.827l-.055-.088c-.197-.315-.176-.703.054-.984a1.094 1.094 0 0 1 .977-.39l.103.012c3.868.572 4.081.637 4.242.728.37.21.517.559.445 1.096l-.44-.304zm-11.99-1.475a1.09 1.09 0 0 0-.975.477 1.096 1.096 0 0 0-.053.985l.042.099c.859 1.847 1.076 2.263 1.207 2.4.227.238.538.338.867.281.931-.163 2.754-2.461 2.832-3.459.05-.644-.289-1.077-.906-1.145l-.103-.012-2.911-.626zm-.072-6.617l-.103.012c-.617.068-.956.501-.906 1.145.077.998 1.9 3.296 2.832 3.459.329.057.64-.043.867-.281.13-.137.347-.553 1.206-2.4l.042-.099a1.096 1.096 0 0 0-.053-.985 1.09 1.09 0 0 0-.975-.477l-2.91.626zm7.777-5.22c-.496-.253-1.093-.199-1.477.037l-2.449 1.494c-.23.281-.251.669-.054.984l.055.088c2.133 3.462 2.293 3.708 2.447 3.827.239.184.539.214.85.09.91-.364 2.888-2.878 3.029-3.847.072-.537-.075-.886-.445-1.096-.161-.09-.374-.156-4.242-.728l-.313-.369zm-6.48-.506l-.103-.012c-.617-.068-1.1.28-1.204.849l-.753 4.258c-.18 1.09 1.064 1.96 2.014 1.367l2.91-1.782c.572-.35.71-.989.415-1.512-.163-.294-.457-.656-3.28-3.945z" fill="currentColor"/>`,
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/burntcrumbs",
    vb: "0 0 18 18",
    icon: `<rect x="2" y="2" width="14" height="14" rx="4" stroke="currentColor" stroke-width="1.4"/><circle cx="9" cy="9" r="3" stroke="currentColor" stroke-width="1.4"/><circle cx="13.5" cy="4.5" r="0.8" fill="currentColor"/>`,
  },
  {
    label: "Facebook",
    href: "https://www.facebook.com/burntcrumbs/",
    vb: "0 0 18 18",
    icon: `<path d="M11 6V4.5c0-.6.4-1 1-1h1V1h-2c-1.7 0-3 1.3-3 3v2H6v2h2v7h3V8h2l.5-2H11z" fill="currentColor"/>`,
  },
];
---

<BurntLayout
  title="Our Story | Burnt Crumbs — Scratch-Made Since 2010"
  description="From a college dorm nickname to Irvine's most-loved brunch spot. The story of Chef Paul Cao, The Burnt Truck, and why we've been keeping it #ScratchMade since 2010."
  canonical="https://burntcrumbs.com/story"
  ogImage="https://burntcrumbs.com/media/story-hero.jpg"
>
  <!-- ── Nav ───────────────────────────────────────────────────────── -->
  <header id="burnt-nav" class="sticky top-0 z-[70] bg-ink text-paper transition-shadow">
    <div class="mx-auto flex max-w-screen-xl items-center justify-between px-4 py-3 md:px-8 md:py-4">
      <a href="/"><img src={`${M}/logo.png`} alt="Burnt Crumbs" class="h-9 w-auto drop-shadow md:h-11" /></a>

      <nav class="hidden items-center gap-8 md:flex">
        {navLinks.map((l) => (
          <a
            href={l.href}
            {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            class={`font-display text-[13px] font-medium uppercase tracking-[0.14em] transition-colors hover:text-paper ${l.href === "/story" ? "text-paper" : "text-paperdim"}`}
          >{l.label}</a>
        ))}
      </nav>

      <div class="hidden items-center gap-0.5 md:flex">
        {socialLinks.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="grid h-9 w-9 place-items-center rounded-full text-paperdim transition-colors hover:text-paper">
            <svg width="16" height="16" viewBox={s.vb} fill="none" set:html={s.icon}></svg>
          </a>
        ))}
      </div>

      <div class="flex items-center gap-2">
        <a href={ORDER_NOW} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full bg-ember px-4 py-2.5 font-display text-[13px] font-semibold uppercase tracking-[0.1em] text-paper shadow-[0_4px_16px_rgba(197,69,58,0.45),inset_0_1px_0_rgba(255,255,255,0.18)]">Order</a>
        <button id="burnt-menu-btn" aria-label="Menu" aria-expanded="false" class="grid h-[42px] w-[42px] place-items-center rounded-full border border-paper/20 bg-paper/[0.18] backdrop-blur md:hidden">
          <div>
            <span class="my-[3px] block h-[1.6px] w-[18px] rounded bg-paper"></span>
            <span class="my-[3px] block h-[1.6px] w-[18px] rounded bg-paper"></span>
            <span class="my-[3px] block h-[1.6px] w-[18px] rounded bg-paper"></span>
          </div>
        </button>
      </div>
    </div>

    <div id="burnt-mobile-menu" class="hidden border-t border-paper/10 bg-ink px-4 pb-5 md:hidden">
      <nav class="flex flex-col">
        {navLinks.map((l) => (
          <a href={l.href} {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})} class="border-b border-paper/10 py-3 font-display text-sm font-medium uppercase tracking-[0.14em] text-paperdim last:border-0">{l.label}</a>
        ))}
      </nav>
      <div class="mt-4 flex gap-1.5 border-t border-paper/10 pt-4">
        {socialLinks.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="grid h-10 w-10 place-items-center rounded-full border border-paper/20 text-paperdim transition-colors hover:text-paper">
            <svg width="16" height="16" viewBox={s.vb} fill="none" set:html={s.icon}></svg>
          </a>
        ))}
      </div>
    </div>
  </header>

  <!-- ── Hero ──────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-char text-paper">
    <div class="absolute inset-0">
      {/*
        IMAGE: story-hero.jpg
        A wide, atmospheric shot of the Burnt Crumbs restaurant — ideally the
        interior with warm lighting, or a spread of signature dishes on the table.
        Aspect ratio: 16:9 or wider. Horizontal composition works best.
      */}
      <img src={`${M}/story-hero.jpg`} alt="Burnt Crumbs restaurant" class="h-full w-full object-cover opacity-60" />
    </div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(14,10,7,0.55)_0%,rgba(14,10,7,0)_40%,rgba(14,10,7,0.85)_100%)]"></div>
    <div class="relative mx-auto flex min-h-[60vh] max-w-screen-xl flex-col justify-end px-5 pb-12 md:min-h-[70vh] md:px-8 lg:px-12">
      <div class="inline-flex items-center gap-2 font-display text-[11px] uppercase tracking-[0.2em] text-paperdim/90">
        <span class="h-1.5 w-1.5 rounded-full bg-ember shadow-[0_0_12px_var(--color-emberlit)]"></span>
        Irvine, CA &nbsp;·&nbsp; Est. 2010 &nbsp;·&nbsp; #scratchmade
      </div>
      <h1 class="mt-3 font-display text-[52px] font-bold uppercase leading-[0.9] tracking-[-0.01em] sm:text-[72px] md:text-[92px]">
        A nickname<br /><em class="font-serif italic font-bold text-ember">that stuck.</em>
      </h1>
    </div>
  </section>

  <!-- ── Origin ────────────────────────────────────────────────────── -->
  <section class="bg-paper px-5 py-16 md:px-8 md:py-24 lg:px-12">
    <div class="mx-auto grid max-w-screen-xl items-center gap-10 md:grid-cols-2 md:gap-16">
      <div>
        <div class="font-display text-[11px] font-medium uppercase tracking-[0.2em] text-char/55">
          <span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-ember align-middle"></span>Where it started
        </div>
        <h2 class="my-3 font-display text-[48px] font-bold uppercase leading-[0.94] tracking-[-0.01em] text-char md:text-[60px]">
          Burnt<br /><em class="font-serif italic font-bold text-ember">spaghetti.</em>
        </h2>
        <p class="burnt-dropcap my-4 font-serif text-base leading-[1.7] text-char/[0.78] md:text-[17px]">
          It started in a college apartment. Chef Paul Cao had a habit of frying the bottom of his spaghetti until it crisped — a little char, a lot of flavor. His roommates started calling it <em class="italic">burnt spaghetti</em>. The name stuck faster than the noodles.
        </p>
        <p class="my-4 font-serif text-base leading-[1.7] text-char/[0.78] md:text-[17px]">
          What started as a dorm-room experiment became an obsession. Chef Paul kept refining the technique — the right amount of sear, the right sauce, the right crisp. By 2010, he had a food truck and a name: <strong class="font-semibold not-italic text-char">The Burnt Truck</strong>.
        </p>
      </div>
      <div class="relative aspect-[4/5] overflow-hidden rounded-[22px] bg-char">
        {/*
          IMAGE: story-original-dish.jpg
          Close-up of the original spaghetti grilled cheese — the dish that started
          it all. Overhead or 45-degree angle, warm lighting, on the press or plated.
        */}
        <img src={`${M}/story-original-dish.jpg`} alt="The original burnt spaghetti dish that started Burnt Crumbs" class="h-full w-full object-cover" />
        <span class="absolute left-3.5 top-3.5 rounded-full bg-char px-2.5 py-1.5 font-display text-[10px] font-semibold uppercase tracking-[0.2em] text-paper">The Original</span>
      </div>
    </div>
  </section>

  <!-- ── Food Truck Era ─────────────────────────────────────────────── -->
  <section class="bg-ink px-5 py-16 text-paper md:px-8 md:py-24 lg:px-12">
    <div class="mx-auto grid max-w-screen-xl items-center gap-10 md:grid-cols-2 md:gap-16">
      <div class="relative aspect-[3/2] overflow-hidden rounded-[22px] bg-char">
        {/*
          IMAGE: story-food-truck.jpg
          The original Burnt Truck food truck, exterior shot. Street or event
          setting, people lining up if possible. Warm, candid, authentic feel.
        */}
        <img src={`${M}/story-food-truck.jpg`} alt="The Burnt Truck food truck, Burnt Crumbs' origin" class="h-full w-full object-cover" />
        <span class="absolute left-3.5 top-3.5 rounded-full bg-ember px-2.5 py-1.5 font-display text-[10px] font-semibold uppercase tracking-[0.2em] text-paper">2010</span>
      </div>
      <div>
        <div class="font-display text-[11px] font-medium uppercase tracking-[0.2em] text-paper/55">
          <span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-ember align-middle"></span>The truck years
        </div>
        <h2 class="my-3 font-display text-[48px] font-bold uppercase leading-[0.94] tracking-[-0.01em] md:text-[60px]">
          The Burnt<br /><em class="font-serif italic font-bold text-ember">Truck.</em>
        </h2>
        <p class="my-4 font-serif text-base leading-[1.7] text-paper/70 md:text-[17px]">
          In 2010, Chef Paul took the concept to the streets. The Burnt Truck rolled through Orange County serving the spaghetti grilled cheese and a rotating roster of scratch-made bites that drew lines wherever it parked.
        </p>
        <p class="my-4 font-serif text-base leading-[1.7] text-paper/70 md:text-[17px]">
          Every sauce made from scratch. Every dish finished to order. No shortcuts, no frozen product — just real food moving fast out of a small truck window.
        </p>
        <div class="mt-6 grid grid-cols-2 gap-4">
          {[
            ["2010", "Founded as The Burnt Truck"],
            ["OC", "Orange County's food truck circuit"],
            ["#1", "Spaghetti grilled cheese goes viral"],
            ["2,400+", "Five-star reviews and counting"],
          ].map(([stat, label]) => (
            <div>
              <div class="font-display text-[36px] font-bold uppercase leading-none text-ember">{stat}</div>
              <div class="mt-1 font-serif text-sm italic text-paper/55">{label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Chef Paul ──────────────────────────────────────────────────── -->
  <section class="bg-paper px-5 py-16 md:px-8 md:py-24 lg:px-12">
    <div class="mx-auto max-w-screen-xl">
      <div class="font-display text-[11px] font-medium uppercase tracking-[0.2em] text-char/55">
        <span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-ember align-middle"></span>The chef
      </div>
      <h2 class="my-3 font-display text-[48px] font-bold uppercase leading-[0.94] tracking-[-0.01em] text-char md:text-[60px]">
        Chef <em class="font-serif italic font-bold text-ember">Paul Cao.</em>
      </h2>
    </div>

    <div class="mx-auto mt-8 grid max-w-screen-xl gap-6 md:grid-cols-3">
      <div class="relative col-span-1 aspect-[3/4] overflow-hidden rounded-[22px] bg-char md:col-span-1">
        {/*
          IMAGE: story-chef-paul.jpg
          Portrait of Chef Paul Cao. Ideally in the kitchen, candid or posed.
          Vertical orientation (portrait) — 3:4 ratio. Warm, natural lighting.
        */}
        <img src={`${M}/story-chef-paul.jpg`} alt="Chef Paul Cao, founder of Burnt Crumbs" class="h-full w-full object-cover" />
      </div>
      <div class="col-span-1 flex flex-col justify-center md:col-span-2 md:pl-8">
        <p class="font-serif text-[18px] leading-[1.7] text-char/80 md:text-[20px]">
          "I never set out to open a restaurant. I just cooked the way I liked to eat — crispy bottoms, bold sauces, nothing pre-made. The truck was a way to share that. The restaurant is what happened when people kept showing up."
        </p>
        <div class="mt-6 font-display text-[13px] font-semibold uppercase tracking-[0.14em] text-char/50">
          — Chef Paul Cao, Founder
        </div>
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <p class="font-serif text-base leading-[1.7] text-char/70">
            Chef-trained, street-seasoned. Paul spent years honing his technique before the truck, then spent a decade behind the window perfecting the menu that Burnt Crumbs is known for today.
          </p>
          <p class="font-serif text-base leading-[1.7] text-char/70">
            Every recipe on the current menu has been tested hundreds of times. The soufflé pancakes, the spaghetti grilled cheese, the Nashville hot chicken — all personal obsessions that made it to the board.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── The Restaurant ────────────────────────────────────────────── -->
  <section class="bg-char px-5 py-16 text-paper md:px-8 md:py-24 lg:px-12">
    <div class="mx-auto grid max-w-screen-xl items-center gap-10 md:grid-cols-2 md:gap-16">
      <div>
        <div class="font-display text-[11px] font-medium uppercase tracking-[0.2em] text-paper/55">
          <span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-ember align-middle"></span>Irvine Center Drive
        </div>
        <h2 class="my-3 font-display text-[48px] font-bold uppercase leading-[0.94] tracking-[-0.01em] md:text-[60px]">
          From truck<br /><em class="font-serif italic font-bold text-ember">to kitchen.</em>
        </h2>
        <p class="my-4 font-serif text-base leading-[1.7] text-paper/70 md:text-[17px]">
          The demand outgrew the truck. The move to Irvine Center Drive gave the team a real kitchen — more menu items, more room, same scratch-made standard. Nothing frozen. Nothing pre-packed. Still the same chef.
        </p>
        <p class="my-4 font-serif text-base leading-[1.7] text-paper/70 md:text-[17px]">
          The Irvine location serves the full menu seven days a week, 8:30 AM to 3:00 PM. Everything still made to order. The sauces still made in-house. The spaghetti still gets crispy on the bottom.
        </p>
        <div class="mt-6 border-t border-paper/10 pt-6">
          <div class="font-display text-[11px] font-medium uppercase tracking-[0.2em] text-paper/50">Find us</div>
          <div class="mt-2 font-display text-[20px] font-bold uppercase leading-[1.2] tracking-[0.01em]">
            8549 Irvine Center Dr.<br />
            <em class="font-serif italic font-normal text-ember">Irvine, CA 92618</em>
          </div>
          <div class="mt-1 font-serif text-sm italic text-paper/50">Mon – Sun · 8:30 AM – 3:00 PM</div>
        </div>
      </div>
      <div class="grid gap-4">
        <div class="relative aspect-[16/10] overflow-hidden rounded-[18px] bg-char">
          {/*
            IMAGE: story-irvine-exterior.jpg
            Exterior of the Irvine Center Dr location — storefront, signage, daytime.
            Horizontal composition, shows the building facade and entrance.
          */}
          <img src={`${M}/story-irvine-exterior.jpg`} alt="Burnt Crumbs restaurant at 8549 Irvine Center Drive" class="h-full w-full object-cover" />
        </div>
        <div class="relative aspect-[16/10] overflow-hidden rounded-[18px] bg-char">
          {/*
            IMAGE: story-kitchen-action.jpg
            Behind-the-scenes kitchen shot — food being prepped or plated,
            the flat-top in action, or sauces being made. Candid energy.
          */}
          <img src={`${M}/story-kitchen-action.jpg`} alt="Behind the scenes in the Burnt Crumbs kitchen" class="h-full w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── Team ──────────────────────────────────────────────────────── -->
  <section class="bg-paper px-5 py-16 md:px-8 md:py-24 lg:px-12">
    <div class="mx-auto max-w-screen-xl">
      <div class="font-display text-[11px] font-medium uppercase tracking-[0.2em] text-char/55">
        <span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-ember align-middle"></span>The crew
      </div>
      <h2 class="my-3 font-display text-[48px] font-bold uppercase leading-[0.94] tracking-[-0.01em] text-char md:text-[60px]">
        Still chef-run,<br /><em class="font-serif italic font-bold text-ember">still family.</em>
      </h2>
      <div class="mt-8 grid gap-8 md:grid-cols-2 md:gap-12">
        <div class="relative aspect-[16/10] overflow-hidden rounded-[22px] bg-char">
          {/*
            IMAGE: story-team.jpg
            Full team photo — everyone who works at Burnt Crumbs together.
            Casual, warm, in or outside the restaurant. Horizontal.
          */}
          <img src={`${M}/story-team.jpg`} alt="The Burnt Crumbs team" class="h-full w-full object-cover" />
        </div>
        <div class="flex flex-col justify-center">
          <p class="font-serif text-base leading-[1.7] text-char/70 md:text-[17px]">
            Burnt Crumbs has always been a family operation. From the truck to the restaurant, the same core team has been there — the same faces, the same standards, the same care.
          </p>
          <p class="mt-4 font-serif text-base leading-[1.7] text-char/70 md:text-[17px]">
            Everyone here believes in the food. They eat it, they argue about it, they stay late to get it right. That's not a policy — it's just how it's always been.
          </p>
          <a href="/menu" class="mt-8 inline-flex items-center gap-2 border-b-[1.5px] border-char pb-0.5 font-display text-[13px] font-semibold uppercase tracking-[0.1em] text-char self-start">
            See the menu <Fragment set:html={arrow} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────── -->
  <section class="bg-ember px-5 py-16 text-paper md:px-8 md:py-20 lg:px-12">
    <div class="mx-auto max-w-screen-xl text-center">
      <h2 class="font-display text-[52px] font-bold uppercase leading-[0.92] tracking-[-0.01em] md:text-[72px]">
        Same crispy edges.<br /><em class="font-serif italic font-bold">Same chef.</em>
      </h2>
      <p class="mx-auto mt-4 max-w-[32ch] font-serif text-[17px] italic leading-[1.4] text-paper/80">
        Scratch-made since 2010. Come find out what the fuss is about.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={ORDER_NOW} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-paper px-7 py-4 font-display text-sm font-semibold uppercase tracking-[0.1em] text-ember shadow-[0_6px_24px_rgba(0,0,0,0.2)]">
          Order Online <Fragment set:html={arrow} />
        </a>
        <a href="/menu" class="inline-flex items-center gap-2 rounded-full border border-paper/50 px-7 py-4 font-display text-sm font-semibold uppercase tracking-[0.1em] text-paper">
          Full Menu <Fragment set:html={arrow} />
        </a>
      </div>
    </div>
  </section>

  <!-- ── Footer ────────────────────────────────────────────────────── -->
  <footer class="bg-char px-5 pb-10 pt-12 text-paperdim md:px-8 md:pt-20 lg:px-12">
    <div class="mx-auto max-w-screen-xl">
      <div class="mb-10 font-display text-[40px] font-bold uppercase leading-[0.88] tracking-[-0.01em] text-paper sm:text-[56px] md:text-[68px] lg:text-[84px]">
        Keeping it<br /><em class="font-serif italic font-bold text-ember">#ScratchMade</em>
      </div>
      <div class="grid gap-10 md:grid-cols-2 md:gap-16">
        <div>
          <p class="max-w-[30ch] font-serif text-[15px] italic leading-[1.4] text-paper/55">Scratch-made since 2010. Started as The Burnt Truck. Still chef-run, still family.</p>
          <div class="mt-6 flex flex-wrap gap-2.5">
            {socialLinks.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="grid h-11 w-11 place-items-center rounded-full border border-paper/20 text-paperdim transition-colors hover:border-ember hover:text-ember">
                <svg width="18" height="18" viewBox={s.vb} fill="none" set:html={s.icon}></svg>
              </a>
            ))}
          </div>
        </div>
        <div class="grid grid-cols-2 content-start gap-x-5 gap-y-4">
          <a href={ORDER_NOW} target="_blank" rel="noopener noreferrer" class="font-display text-[13px] font-medium uppercase tracking-[0.06em] text-paper">Order Online <span class="ml-1 text-ember">↗</span></a>
